; Runs in screen-helper DOCK chunk 6. It never reads document bytes (HOME
; C000..DFFF is hidden). Eligible edits are proven from the committed splice
; and retained descriptors; all other changes use the ordinary full renderer.
FastAppend:
        ld a,(CacheValid)
        or a
        jp z,FastAppendMiss
        ld a,(EditPending)
        cp 1
        jp nz,FastAppendMiss
        ld a,(ManualPan)
        or a
        jp nz,FastAppendMiss
        ld a,(LastFull)
        or a
        jp nz,FastAppendMiss
        ld a,(ViewMode)
        ld hl,LastMode
        cp (hl)
        jp nz,FastAppendMiss
        ld hl,(TopLine)
        ld de,(LastTop)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld hl,(PanX)
        ld de,(LastPan)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld hl,(OldSelStart)
        ld de,(OldSelEnd)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld hl,(EditDelta)
        dec hl
        ld a,h
        or l
        jp nz,FastAppendMiss
        ld hl,(SpliceCount)
        dec hl
        ld a,h
        or l
        jp nz,FastAppendMiss
        ld hl,(SpliceSource)
        ld de,EditBytes
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld hl,(LastViewLength)
        ld de,(LastViewCursor)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld hl,(SpliceStart)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld hl,(SpliceEnd)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        inc de
        ld hl,(Length)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld hl,(Cursor)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld a,(Typed)
        cp 32
        jp c,FastAppendMiss
        cp 127
        jp nc,FastAppendMiss
        ld a,(TokenStyle)
        and 96
        jp nz,FastAppendMiss
        ld a,(TokenStyle)
        ld hl,BeforeStyle
        cp (hl)
        jp nz,FastAppendMiss
        ld a,(TokenFont)
        ld hl,BeforeFont
        cp (hl)
        jp nz,FastAppendMiss
        ld hl,(CaretLine)
        ld de,(TopLine)
        or a
        sbc hl,de
        jp c,FastAppendMiss
        ld a,h
        or a
        jp nz,FastAppendMiss
        ld a,l
        cp LINECOUNT
        jp nc,FastAppendMiss
        ld (RenderIndex),a
        call Descriptor
        ld (AppendDescriptor),hl
        push hl
        ld de,6
        add hl,de
        ld a,(hl)
        pop hl
        or a
        jp nz,FastAppendMiss
        ld e,(hl)
        inc hl
        ld d,(hl)
        inc hl
        ld c,(hl)
        inc hl
        ld b,(hl)
        ld a,b
        cp 255
        jp z,FastAppendMiss
        ld h,b
        ld l,c
        add hl,de
        ld de,(LastViewLength)
        or a
        sbc hl,de
        jp nz,FastAppendMiss
        ld a,(TokenFont)
        ld (CurrentFont),a
        ld a,(TokenStyle)
        ld (CurrentStyle),a
        ld a,(Typed)
        call FastAppendMetric
        ld a,(GlyphScratch)
        ld e,a
        ld d,0
        ld hl,(CaretX)
        add hl,de
        ld (AppendNextX),hl
        ld de,(PageRight)
        or a
        sbc hl,de
        jp nc,FastAppendMiss
        ld a,(ViewMode)
        or a
        jr z,FastAppendGeometry
        ld hl,(AppendNextX)
        ld de,(PanX)
        or a
        sbc hl,de
        jp c,FastAppendMiss
        ld de,248
        or a
        sbc hl,de
        jp nc,FastAppendMiss
FastAppendGeometry:
        ; Three physical columns on each plane cover every supported glyph,
        ; including bold/italic spill at every bit alignment. Preserve old ink.
        ld hl,(CaretX)
        ld a,(ViewMode)
        or a
        jr z,FastAppendHires
        ld de,(PanX)
        or a
        sbc hl,de
        jp c,FastAppendMiss
        jr FastAppendColumn
FastAppendHires:
        srl h
        rr l
FastAppendColumn:
        srl h
        rr l
        srl l
        srl l
        ld a,l
        ld (StripStart),a
        ld a,32
        sub l
        cp 3
        jr c,FastAppendWidth
        ld a,3
FastAppendWidth:
        ld (PanColumns),a
        ld a,1
        ld (StripActive),a
        call FastAppendSeed
        ld hl,(CaretX)
        ld (PenX),hl
        ld a,1
        ld (BufferActive),a
        xor a
        ld (GlyphSelected),a
        ld (DrawY),a
        ld (StripActive),a
        ld a,(Typed)
        call FastAppendDraw
        xor a
        ld (BufferActive),a
        inc a
        ld (StripActive),a
        call PublishLine
        ld hl,(AppendNextX)
        ld (CaretX),hl
        ld hl,(AppendDescriptor)
        inc hl
        inc hl
        inc (hl)
        jr nz,FastAppendLength
        inc hl
        inc (hl)
        dec hl
FastAppendLength:
        ld de,128
        add hl,de
        inc (hl)
        jr nz,FastAppendCache
        inc hl
        inc (hl)
FastAppendCache:
        ld hl,(Length)
        ld (LastViewLength),hl
        ld (LastViewCursor),hl
        ld (FormatScanPos),hl
        ld a,(TokenFont)
        ld (ScanFont),a
        ld a,(TokenStyle)
        ld (ScanStyle),a
        xor a
        ld (EditPending),a
        ld (StripActive),a
        ld (PanRedraw),a
        ld a,1
        ld (LinesPainted),a
        call CaretShow
        call PointerShow
        scf
        ret
FastAppendMiss:
        or a
        ret

FastAppendSeed:
        ld a,(RenderIndex)
        call LineY
        ld (CopyY),a
        ld hl,LINEBUF
        ld (CopyPtr),hl
        ld a,16
        ld (CopyRows),a
FastAppendSeedRow:
        ld a,(CopyY)
        call RowAddress
        ld de,(CopyPtr)
        call FastAppendSeedBytes
        ld a,(CopyY)
        call RowAddress
        set 5,h
        push hl
        ld hl,(CopyPtr)
        ld de,512
        add hl,de
        ex de,hl
        pop hl
        call FastAppendSeedBytes
        ld hl,(CopyPtr)
        ld de,32
        add hl,de
        ld (CopyPtr),hl
        ld hl,CopyY
        inc (hl)
        ld hl,CopyRows
        dec (hl)
        jr nz,FastAppendSeedRow
        ret
FastAppendSeedBytes:
        ld a,(StripStart)
        ld c,a
        ld b,0
        add hl,bc
        ex de,hl
        add hl,bc
        ex de,hl
        ld a,(PanColumns)
        ld c,a
        ldir
        ret
